{
  "name": "@automacene/luminal-memory",
  "version": "1.0.0",
  "description": "Zero-dependency infinite context memory for any LLM. Runs in browser and Node.js.",
  "main": "dist/luminal-memory.umd.js",
  "module": "src/index.js",
  "browser": "dist/luminal-memory.umd.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./dist/luminal-memory.umd.js",
      "browser": "./dist/luminal-memory.umd.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "esbuild src/index.js --bundle --minify --outfile=dist/luminal-memory.min.js --format=esm",
    "build:umd": "esbuild src/index.js --bundle --minify --outfile=dist/luminal-memory.umd.js --format=iife --global-name=LuminalMemory",
    "test": "node --test tests/*.test.js",
    "dev": "esbuild src/index.js --bundle --outfile=dist/luminal-memory.js --format=esm --watch",
    "demo": "npm run build:umd && node serve.js"
  },
  "keywords": [
    "llm",
    "memory",
    "context",
    "bm25",
    "bloom-filter",
    "infinite-context",
    "local-ai",
    "sliding-window"
  ],
  "author": "Automacene",
  "license": "Apache-2.0",
  "devDependencies": {
    "cheerio": "^1.2.0",
    "esbuild": "^0.21.0",
    "gifuct-js": "^2.1.2",
    "turndown": "^7.2.4",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.62.1",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.8.0"
  }
}
